Sub ハイフン前の数字を1増やす()

    '--- 設定 ---
    ' 処理対象の列 (例: "A", "B", "C" など)
    Dim 対象列 As String
    ' 処理を開始する行番号
    Dim 開始行 As Long
    ' 処理を終了する行番号 (または最終行まで処理する場合は 0 を設定)
    Dim 終了行 As Long
    
    '--- 正規表現オブジェクトの宣言 ---
    Dim 正規表現 As Object
    Set 正規表現 = CreateObject("VBScript.RegExp")

    '--- 変数の初期設定 (ここを必要に応じて変更してください) ---
    対象列 = "A" ' 例: A列を対象とする
    開始行 = 1       ' 例: 1行目から処理を開始する
    終了行 = 0         ' 例: 最終行まで処理する場合 (0を設定)
    
    ' 検索する正規表現パターン: 「数字の並び-数字の並び」
    ' 例: "123-456" や "1-2" のようなパターンにマッチします。
    正規表現.Pattern = "(\d+)-(\d+)"
    正規表現.Global = True ' セル内のすべての一致箇所を処理する

    '--- 最終行の特定 (終了行が0の場合) ---
    If 終了行 = 0 Then
        終了行 = Cells(Rows.Count, 対象列).End(xlUp).Row
    End If

    '--- 列内のセルをループして置換 ---
    Dim 行番号 As Long
    Dim セル内の元のテキスト As String
    Dim 見つかった全ての候補 As Object ' MatchCollection (一致した全てのパターンを格納)
    Dim 見つかった一つの候補 As Object   ' Match (個々の一致パターン)
    Dim ハイフン前の数字 As Long
    Dim ハイフン後の数字 As String
    Dim 置き換える文字列 As String

    For 行番号 = 開始行 To 終了行
        ' セルの値を文字列として取得
        セル内の元のテキスト = CStr(Cells(行番号, 対象列).Value)
        
        ' 正規表現にマッチする箇所を全て取得
        Set 見つかった全ての候補 = 正規表現.Execute(セル内の元のテキスト)

        ' マッチする箇所がなければ次のセルへ
        If 見つかった全ての候補.Count = 0 Then
            GoTo 次のセルへ
        End If

        ' 新しい文字列を構築するための変数
        Dim 現在の処理位置 As Long
        現在の処理位置 = 1

        Dim 変更後の文字列 As String
        変更後の文字列 = ""

        ' 見つかった候補を一つずつ処理し、新しい文字列を組み立てる
        For Each 見つかった一つの候補 In 見つかった全ての候補
            ' マッチするまでの部分を「変更後の文字列」に追加
            変更後の文字列 = 変更後の文字列 & Mid(セル内の元のテキスト, 現在の処理位置, 見つかった一つの候補.FirstIndex - 現在の処理位置 + 1)

            ' マッチした部分の処理
            ' ハイフン前の数字を取得し、1加算
            ハイフン前の数字 = CLng(見つかった一つの候補.SubMatches(0))
            ハイフン前の数字 = ハイフン前の数字 + 1

            ' ハイフン後の数字を取得
            ハイフン後の数字 = 見つかった一つの候補.SubMatches(1)
            
            ' 新しい「置き換える文字列」を作成
            置き換える文字列 = CStr(ハイフン前の数字) & "-" & ハイフン後の数字
            
            ' 「置き換える文字列」を「変更後の文字列」に追加
            変更後の文字列 = 変更後の文字列 & 置き換える文字列
            
            ' 次の処理開始位置を更新
            現在の処理位置 = 見つかった一つの候補.FirstIndex + 見つかった一つの候補.Length + 1
        Next 見つかった一つの候補

        ' 最後のマッチ以降の部分を「変更後の文字列」に追加
        変更後の文字列 = 変更後の文字列 & Mid(セル内の元のテキスト, 現在の処理位置)

        ' 変更後の文字列をセルに書き戻す
        Cells(行番号, 対象列).Value = 変更後の文字列

次のセルへ:
    Next 行番号

    '--- 終了処理 ---
    Set 正規表現 = Nothing ' オブジェクトの解放
    MsgBox "置換処理が完了しました。", vbInformation
    
End Sub
